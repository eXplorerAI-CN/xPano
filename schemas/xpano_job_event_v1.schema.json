{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xpano.local/schemas/xpano_job_event_v1.schema.json",
  "title": "xPano Job Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sequence",
    "timestamp",
    "projectId",
    "jobId",
    "workspace",
    "kind",
    "stageId",
    "trackId",
    "state",
    "current",
    "total",
    "unit",
    "percent",
    "etaSeconds",
    "message",
    "payload"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "projectId": { "type": "string", "minLength": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "workspace": { "enum": ["media", "reconstruction", "results", "training"] },
    "kind": {
      "enum": [
        "job.started",
        "job.completed",
        "job.failed",
        "job.cancelled",
        "stage.started",
        "stage.progress",
        "stage.heartbeat",
        "stage.completed",
        "stage.skipped",
        "stage.failed",
        "artifact.created",
        "preview.item",
        "log.line"
      ]
    },
    "stageId": { "type": ["string", "null"] },
    "trackId": { "type": ["string", "null"] },
    "state": { "enum": ["queued", "running", "cancelling", "completed", "failed", "cancelled", "skipped", "interrupted"] },
    "current": { "type": ["integer", "null"], "minimum": 0 },
    "total": { "type": ["integer", "null"], "minimum": 0 },
    "unit": { "type": ["string", "null"] },
    "percent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "etaSeconds": { "type": ["integer", "null"], "minimum": 0 },
    "message": { "type": "string" },
    "payload": { "type": "object" }
  }
}
